@article{
bloch2105nasduck,
author = {Itay M. Bloch  and Gil Ronen  and Roy Shaham  and Ori Katz  and Tomer Volansky  and Or Katz },
title = {{New constraints on axion-like dark matter using a Floquet quantum detector}},
journal = {Science Advances},
volume = {8},
number = {5},
pages = {eabl8919},
year = {2022},
doi = {10.1126/sciadv.abl8919},
URL = {https://www.science.org/doi/abs/10.1126/sciadv.abl8919},
eprint = {https://www.science.org/doi/pdf/10.1126/sciadv.abl8919},
abstract = {Dark matter is one of the greatest mysteries in physics. It interacts via gravity and composes most of our universe, but its elementary composition is unknown. We search for nongravitational interactions of axion-like dark matter with atomic spins using a precision quantum detector. The detector is composed of spin-polarized xenon gas that can coherently interact with a background dark matter field as it traverses through the galactic dark matter halo. Conducting a 5-month-long search, we report on the first results of the Noble and Alkali Spin Detectors for Ultralight Coherent darK matter (NASDUCK) collaboration. We limit ALP-neutron interactions in the mass range of 4 \ensuremath{\times} 10-15 to 4 \ensuremath{\times} 10-12 eV/c2 and improve upon previous terrestrial bounds by up to 1000-fold for masses above 4 \ensuremath{\times} 10-13 eV/c2. We also set bounds on pseudoscalar dark matter models with quadratic coupling. Bounds are set on ultralight dark matter and its interaction with neutrons using a Floquet NMR quantum detector.}}



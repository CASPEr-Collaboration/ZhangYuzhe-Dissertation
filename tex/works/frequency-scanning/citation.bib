@article{Preskill1983invisibleaxion,
title = {Cosmology of the invisible axion},
journal = {Physics Letters B},
volume = {120},
number = {1},
pages = {127-132},
year = {1983},
issn = {0370-2693},
doi = {https://doi.org/10.1016/0370-2693(83)90637-8},
url = {https://www.sciencedirect.com/science/article/pii/0370269383906378},
author = {John Preskill and Mark B. Wise and Frank Wilczek},
abstract = {We identify a new cosmological problem for models which solve the strong CP puzzle with an invisible axion, unrelated to the domain wall problem. Because the axion is very weakly coupled, the energy density stored in the oscillations of the classical axion field does not dissipate rapidly; it exceeds the critical density needed to close the universe unless fa ⩽ 1012GeV, wherefa is the axion decay constant. If this bound is saturated, axions may comprise the dark matter of the universe.}
}

﻿@Article{Gramolin2021ALPferro,
author={Gramolin, Alexander V.
and Aybas, Deniz
and Johnson, Dorian
and Adam, Janos
and Sushkov, Alexander O.},
title={Search for axion-like dark matter with ferromagnets},
journal={Nature Physics},
year={2021},
month={Jan},
day={01},
volume={17},
number={1},
pages={79-84},
abstract={Ultralight axion-like particles are well-motivated dark matter candidates, naturally emerging from theories of physics at ultrahigh energies. Here we report the results of a direct search for electromagnetic interactions of axion-like dark matter in the mass range that spans three decades from 12{\thinspace}peV to 12{\thinspace}neV. The detection scheme is based on a modification of Maxwell's equations in the presence of axion-like dark matter that mixes with a static magnetic field to produce an oscillating magnetic field. The experiment makes use of toroidal magnets with ferromagnetic powder cores made of an iron--nickel alloy, which enhance the static magnetic field by a factor of 24. Using superconducting quantum interference devices, we achieve magnetic sensitivity of 150{\thinspace}{\$}{\$}{\backslash}mathrm{\{}aT{\}}{\backslash}, {\{}{\backslash}mathrm{\{}Hz{\}}{\}}^{\{}-1/2{\}}{\$}{\$}, which is at the level of the most sensitive magnetic field measurements demonstrated with any broadband sensor. We recorded 41{\thinspace}h of data and improved the best limits on the magnitude of electromagnetic coupling constant for axion-like dark matter over a part of our mass range, at 20{\thinspace}peV reaching 4.0{\thinspace}{\texttimes}{\thinspace}10−11{\thinspace}GeV−1 (95{\%} confidence level). Our measurements begin to explore the coupling strengths and masses of axion-like particles, where their mixing with photons could explain the anomalous transparency of the Universe to TeV $\gamma$-rays.},
issn={1745-2481},
doi={10.1038/s41567-020-1006-6},
url={https://doi.org/10.1038/s41567-020-1006-6}
}

